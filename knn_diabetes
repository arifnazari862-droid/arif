import pandas as pd
import numpy as np
from sklearn.preprocessing import MinMaxScaler
from sklearn.neighbors import KNeighborsClassifier

def buat_sistem_knn():
    # 1. Dataset Pelatihan (10 Pasien awal)
    data = [
        ["P01", 25, 21.5, 90, 110, 0, 0],
        ["P02", 30, 23.1, 95, 115, 0, 0],
        ["P03", 35, 25.0, 105, 120, 0, 0],
        ["P04", 40, 27.5, 120, 125, 1, 1],
        ["P05", 45, 30.2, 140, 135, 1, 1],
        ["P06", 50, 31.5, 155, 140, 1, 1],
        ["P07", 55, 33.0, 165, 145, 1, 1],
        ["P08", 28, 22.5, 92, 112, 0, 0],
        ["P09", 38, 26.8, 115, 122, 0, 0],
        ["P10", 48, 29.5, 145, 130, 1, 1]
    ]

    columns = ["Pasien", "Usia", "BMI", "Glukosa", "TekananDarah", "RiwayatKeluarga", "Kelas"]
    df = pd.DataFrame(data, columns=columns)

    # 2. Pemisahan Fitur dan Target
    X = df[["Usia", "BMI", "Glukosa", "TekananDarah", "RiwayatKeluarga"]]
    y = df["Kelas"]

    # 3. Normalisasi Data
    scaler = MinMaxScaler()
    X_scaled = scaler.fit_transform(X)

    # 4. Pelatihan Model KNN (K=3)
    k = 3
    knn = KNeighborsClassifier(n_neighbors=k)
    knn.fit(X_scaled, y)

    # 5. Fungsi Prediksi Pasien Baru
    def prediksi_pasien(usia, bmi, glukosa, tekanan_darah, riwayat_keluarga):
        pasien_baru = pd.DataFrame([[usia, bmi, glukosa, tekanan_darah, riwayat_keluarga]], 
                                   columns=["Usia", "BMI", "Glukosa", "TekananDarah", "RiwayatKeluarga"])
        
        pasien_baru_scaled = scaler.transform(pasien_baru)
        prediksi = knn.predict(pasien_baru_scaled)[0]
        probabilitas = knn.predict_proba(pasien_baru_scaled)[0]

        label = "Risiko Tinggi (1)" if prediksi == 1 else "Risiko Rendah (0)"
        return label, probabilitas[prediksi]

    return prediksi_pasien

# === UJI COBA SISTEM ===
sistem_prediksi = buat_sistem_knn()

# Data pasien baru dari studi kasus
usia = 42
bmi = 28.5
glukosa = 130
tekanan_darah = 128
riwayat_keluarga = 1

label, kepastian = sistem_prediksi(usia, bmi, glukosa, tekanan_darah, riwayat_keluarga)

